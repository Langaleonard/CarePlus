@model List<Prescription>
@{ ViewData["Title"] = "Prescriptions"; }
<section class="panel"><div class="panel-head"><p class="muted">Digital prescriptions issued through Care Plus.</p><a class="btn primary" asp-action="Create">Add prescription</a></div><div class="table-wrap"><table><thead><tr><th>Patient</th><th>Doctor</th><th>Medication</th><th>Dosage</th><th>Date</th><th></th></tr></thead><tbody>@foreach (var item in Model){<tr><td><strong>@item.PatientName</strong></td><td>@item.DoctorName</td><td>@item.Medication<small>@item.Instructions</small></td><td>@item.Dosage</td><td>@item.PrescriptionDate</td><td><a class="btn small ghost" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td></tr>}</tbody></table></div></section>
