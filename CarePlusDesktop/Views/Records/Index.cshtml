@model List<MedicalRecord>
@{ ViewData["Title"] = "Medical Records"; }
<section class="panel">
    <div class="panel-head"><p class="muted">Clinical records available to authorised administrators.</p><a class="btn primary" asp-action="Create">Add record</a></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Diagnosis</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr><td><strong>@item.PatientName</strong></td><td>@item.DoctorName</td><td>@item.RecordDate</td><td>@item.Diagnosis<small>@item.TreatmentNotes</small></td><td class="actions"><a class="btn small ghost" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Delete" method="post" onsubmit="return confirm('Delete this medical record?');"><input type="hidden" name="id" value="@item.Id"/><button class="btn small danger">Delete</button></form></td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any()) { <div class="empty">No medical records have been added yet.</div> }
</section>
