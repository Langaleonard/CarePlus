@model DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="status-strip @(Model.FirebaseConnected ? "online" : "demo")">
    <strong>@(Model.FirebaseConnected ? "Firebase connected" : "Demo mode")</strong>
    <span>@(Model.FirebaseConnected ? "Live mobile-app data is being used." : "Add your Firebase configuration to use the shared cloud database.")</span>
</div>
<div class="stats-grid">
    <div class="stat-card"><span>Patients</span><strong>@Model.Patients</strong><small>Registered profiles</small></div>
    <div class="stat-card"><span>Doctors</span><strong>@Model.Doctors</strong><small>Healthcare professionals</small></div>
    <div class="stat-card"><span>Appointments</span><strong>@Model.Appointments</strong><small>@Model.PendingAppointments waiting for action</small></div>
    <div class="stat-card"><span>Records</span><strong>@Model.MedicalRecords</strong><small>Medical records</small></div>
    <div class="stat-card"><span>Prescriptions</span><strong>@Model.Prescriptions</strong><small>Digital prescriptions</small></div>
</div>
<div class="content-grid two">
    <section class="panel">
        <div class="panel-head"><h2>Upcoming appointments</h2><a class="btn ghost" asp-controller="Appointments">View all</a></div>
        @if (!Model.RecentAppointments.Any()) { <div class="empty">No appointments found.</div> }
        else
        {
            <div class="list-stack">
                @foreach (var item in Model.RecentAppointments)
                {
                    var patient = string.IsNullOrWhiteSpace(item.PatientName) || item.PatientName.Equals("null", StringComparison.OrdinalIgnoreCase) ? "Patient" : item.PatientName;
                    var doctor = string.IsNullOrWhiteSpace(item.DoctorName) || item.DoctorName.Equals("null", StringComparison.OrdinalIgnoreCase) ? "Not assigned" : item.DoctorName;
                    <div class="list-row"><div class="avatar">@patient.FirstOrDefault()</div><div class="grow"><strong>@patient</strong><small>@doctor · @item.Date @(string.IsNullOrWhiteSpace(item.Time) ? "" : item.Time)</small></div><span class="badge @item.Status.ToLowerInvariant()">@item.Status</span></div>
                }
            </div>
        }
    </section>
    <section class="panel">
        <h2>Administration</h2>
        <div class="quick-grid">
            <a asp-controller="Patients" asp-action="Create"><strong>+ Patient</strong><span>Create a patient profile</span></a>
            <a asp-controller="Doctors" asp-action="Create"><strong>+ Doctor</strong><span>Add a healthcare professional</span></a>
            <a asp-controller="Appointments" asp-action="Create"><strong>+ Appointment</strong><span>Schedule a consultation</span></a>
            <a asp-controller="Reports"><strong>View reports</strong><span>System overview</span></a>
        </div>
    </section>
</div>
