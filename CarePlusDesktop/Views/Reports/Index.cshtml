@model DashboardViewModel
@{ ViewData["Title"] = "Reports"; }
<div class="stats-grid reports-stats"><div class="stat-card"><span>Total patients</span><strong>@Model.Patients</strong></div><div class="stat-card"><span>Total doctors</span><strong>@Model.Doctors</strong></div><div class="stat-card"><span>Total appointments</span><strong>@Model.Appointments</strong></div><div class="stat-card"><span>Pending</span><strong>@Model.PendingAppointments</strong></div></div>
<section class="panel"><h2>Operational overview</h2><div class="report-bars"><div><span>Medical records</span><strong>@Model.MedicalRecords</strong></div><div><span>Prescriptions</span><strong>@Model.Prescriptions</strong></div><div><span>Database</span><strong>@(Model.FirebaseConnected ? "Firebase live" : "Demo mode")</strong></div></div><p class="muted">Care Plus administrative summary for the desktop application.</p></section>
