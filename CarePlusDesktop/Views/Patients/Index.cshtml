@model List<Patient>
@{ ViewData["Title"] = "Patients"; }
<section class="panel">
    <div class="panel-head"><form class="search-form"><input name="q" value="@ViewBag.Query" placeholder="Search patients..."/><button class="btn ghost">Search</button></form><a class="btn primary" asp-action="Create">Add patient</a></div>
    <div class="table-wrap"><table><thead><tr><th>Patient</th><th>Contact</th><th>Date of birth</th><th>Gender</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td><strong>@item.FullName</strong><small>@item.Address</small></td><td>@item.Email<small>@item.Phone</small></td><td>@item.DateOfBirth</td><td>@item.Gender</td><td class="actions"><a class="btn small ghost" asp-action="Edit" asp-route-id="@item.Id">Edit</a><form asp-action="Delete" method="post" onsubmit="return confirm('Delete this patient?');"><input type="hidden" name="id" value="@item.Id"/><button class="btn small danger">Delete</button></form></td></tr> }
    </tbody></table></div>
    @if (!Model.Any()) { <div class="empty">No patients found.</div> }
</section>
